PORT=3000
SENTRY_DSN=
NODE_ENV=dev

# analytics (optional, requests are not tracked when the key is missing)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# stable salt for hashing consumer ids, generated per boot when unset
ANALYTICS_SALT=
# number of proxy hops to trust for the client ip, unset means none
TRUST_PROXY=
